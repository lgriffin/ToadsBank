{
  "name": "toadsbank",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": ["packages/domain", "packages/application", "packages/adapters/*", "apps/*"],
  "scripts": {
    "lint": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && npm run test:bdd",
    "test:arch": "vitest run tests/architecture.test.ts",
    "test:contract": "vitest run --project contract",
    "trace": "tsx scripts/trace.ts --check",
    "trace:write": "tsx scripts/trace.ts --write",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:bdd": "node --import tsx node_modules/@cucumber/cucumber/bin/cucumber.js",
    "mutation": "stryker run stryker.domain.json"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@cucumber/cucumber": "^11.3.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.11.10",
    "ajv": "^8.17.1",
    "fast-check": "^3.23.2",
    "pg": "^8.13.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
