{
  "name": "toadsbank",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": ["packages/domain", "packages/application", "packages/adapters/*", "apps/*"],
  "scripts": {
    "lint": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:arch": "vitest run tests/architecture.test.ts",
    "test:contract": "vitest run tests/contract",
    "trace": "tsx scripts/trace.ts --check",
    "trace:write": "tsx scripts/trace.ts --write",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^22.20.4",
    "ajv": "^8.17.1",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "pg": "^8.13.0",
    "@types/pg": "^8.11.10"
  }
}
